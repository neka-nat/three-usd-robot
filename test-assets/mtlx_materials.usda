#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Steel"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Steel/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 1
                color3f inputs:base_color = (0.2, 0.3, 0.4)
                float inputs:coat = 1
                float inputs:coat_roughness = 0.15
                float inputs:metalness = 0.9
                float inputs:specular_IOR = 1.6
                float inputs:specular_roughness = 0.35
                token outputs:out
            }
        }

        def Material "Textured"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Textured/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color.connect = </World/Looks/Textured/Image.outputs:out>
                token outputs:out
            }

            def Shader "Image"
            {
                uniform token info:id = "ND_tiledimage_color3"
                asset inputs:file = @./crate.png@
                float2 inputs:uvtiling = (2, 2)
                color3f outputs:out
            }
        }

        def Material "Preview"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Preview/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
                color3f inputs:diffuseColor = (0.8, 0.1, 0.1)
                float inputs:roughness = 0.5
                token outputs:out
            }
        }
    }

    def Cube "steel" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Steel>
        double size = 0.1
    }

    def Cube "textured" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Textured>
        double size = 0.1
    }

    def Cube "preview" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Preview>
        double size = 0.1
    }
}

