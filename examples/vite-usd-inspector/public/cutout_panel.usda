#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    metersPerUnit = 1.0
    doc = "Alpha-clip cutout — opacity from the diffuse texture's alpha + opacityThreshold."
)

def Xform "World" ( prepend apiSchemas = ["PhysicsArticulationRootAPI"] )
{
    def Scope "Looks"
    {
        def Material "Cutout"
        {
            token outputs:surface.connect = </World/Looks/Cutout/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/Cutout/Image.outputs:rgb>
                float inputs:opacity.connect = </World/Looks/Cutout/Image.outputs:a>
                float inputs:opacityThreshold = 0.5
                float inputs:roughness = 0.7
                token outputs:surface
            }
            def Shader "Image"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/cutout.png@
                token outputs:rgb
                float outputs:a
            }
        }
    }

    def Xform "panel_link" ( prepend apiSchemas = ["PhysicsRigidBodyAPI"] )
    {
        def Mesh "geom"
        {
            rel material:binding = </World/Looks/Cutout>
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            point3f[] points = [(-1, 0, 0), (1, 0, 0), (1, 0, 2), (-1, 0, 2)]
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)]
            uniform bool doubleSided = true
        }
    }

    def PhysicsFixedJoint "root_joint"
    {
        rel physics:body1 = </World/panel_link>
    }
}
